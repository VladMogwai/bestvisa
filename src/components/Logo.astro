---
// BestVisa logo: the paper plane from the original sign, redrawn geometric, plus the wordmark.
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['logo-mark', { 'logo-mark--inverse': inverse }]} aria-hidden="true">
  <svg viewBox="0 0 80 80">
    <path d="M4 36L76 4 54 74 36 50z" fill="var(--logo-plane, var(--brand))" />
    <path d="M36 50L76 4 26 42z" fill="var(--logo-fold, var(--cta))" />
    <path d="M36 50l-4 22 12-14z" fill="var(--logo-plane, var(--brand))" />
  </svg>
  <span>bestvisa</span>
</span>
