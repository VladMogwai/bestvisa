---
import { company } from '../data/site.js';

interface Props {
  lead?: string;
}
const { lead = 'Помогаем россиянам с 2013 года оформлять визы быстро, профессионально и без лишних хлопот.' } = Astro.props;
const screens = [1, 2, 3, 4, 5, 6];
---

<section class="section">
  <div class="wrap proof">
    <div>
      <span class="eyebrow">Отзывы</span>
      <p class="proof__count"><span data-count style="color:inherit">{company.clients}</span><span>+</span></p>
      <h2>клиентов уже получили визу и другие услуги в BestVisa</h2>
      <p style="color:var(--muted)">{lead}</p>
      <a class="trust" href={company.rating.url} target="_blank" rel="noopener nofollow">
        <span class="trust__ya">Я</span>
        <span>Надёжный бизнес <b>{company.rating.value}</b> <span class="trust__stars">★★★★★</span> · {company.rating.count} отзыва на Яндекс Картах</span>
      </a>
    </div>
    <div class="proof__screens" tabindex="0" aria-label="Скриншоты переписки с клиентами">
      {screens.map((n) => <img src={`/shared/assets/images/screen${n}.webp`} alt="Отзыв клиента BestVisa в мессенджере" loading="lazy" width="260" height="520" />)}
    </div>
  </div>
</section>
