---
import Base from '../layouts/Base.astro';
import LeadForm from './LeadForm.astro';
import Sections from './Sections.astro';
import Ico from './Ico.astro';
import { SITE_URL, company } from '../data/site.js';
import { heroImage } from '../data/pages.js';

interface Props {
  page: any;
}
const { page } = Astro.props;
const heroBg = heroImage(page);
const FEATURE_ICONS = ['person', 'contract', 'visa', 'calendar', 'chat', 'docs', 'plane', 'shield'] as const;
const price = page.hero?.price?.replace(/\s*руб\.?$/, ' ₽') || '';
const term = page.hero?.term?.replace(/^(Срок оформления|Готовность —)\s*/, '') || '';

const sections = page.sections.some((s: any) => s.kind === 'finalCta') ? page.sections : [...page.sections, { kind: 'finalCta' }];
const pricing = page.sections.find((s: any) => s.kind === 'pricing');
const faq = page.sections.find((s: any) => s.kind === 'faq');
const priceNum = (s: string) => Number((s || '').replace(/[^\d]/g, '')) || undefined;
const strip = (h: string) => h.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const crumbs = [{ name: 'Главная', href: '/' }, ...page.breadcrumbs, { name: page.h1, href: page.path }];
const schema: object[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE_URL + c.href })),
  },
  {
    '@type': 'Service',
    name: page.h1,
    description: page.description,
    serviceType: page.h1,
    areaServed: { '@type': 'Country', name: 'Россия' },
    provider: { '@id': `${SITE_URL}/#localbusiness` },
    ...(pricing && {
      offers: pricing.tabs.map((t: any) => ({
        '@type': 'Offer',
        name: t.name,
        price: priceNum(t.total),
        priceCurrency: 'RUB',
        url: SITE_URL + page.path + '#pricing',
      })),
    }),
  },
];
if (faq) {
  schema.push({
    '@type': 'FAQPage',
    mainEntity: faq.items.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
  });
}
---

<Base title={page.title} description={page.description} path={page.path} image={heroBg} schema={schema}>
  <section class="hero">
    <div class="hero__split">
      <div class="hero__panel">
        <ol class="crumbs">
          {crumbs.slice(0, -1).map((c) => <li><a href={c.href}>{c.name}</a></li>)}
        </ol>
        <a class="trust" href={company.rating.url} target="_blank" rel="noopener nofollow">
          {page.flag ? <span class="hero__flag"><img src={page.flag} alt="" /></span> : <span class="trust__ya">Я</span>}
          <span>Надёжный бизнес <b>{company.rating.value}</b> <span class="trust__stars">★★★★★</span> {company.rating.count} оценки на Яндексе</span>
        </a>
        <h1>{page.h1}</h1>
        {
          (term || price) && (
            <div class="hero__facts">
              {price && <span><small>Цена</small>{price}</span>}
              {term && <span><small>Срок оформления</small>{term}</span>}
            </div>
          )
        }
        {page.hero?.lead && <p class="hero__lead" set:html={page.hero.lead} />}
        <div class="hero__form"><LeadForm page={page.h1} /></div>
      </div>
      <div class="hero__photo">
        <img src={heroBg} alt={page.h1} fetchpriority="high" />
        <span class="hero__badge"><b>{company.clients}</b>клиентов с 2013 года</span>
      </div>
    </div>
    {
      page.hero?.features?.length > 0 && (
        <div class="strip">
          <ul class="strip__list">
            {page.hero.features.slice(0, 8).map((f: string, i: number) => (
              <li>
                <Ico name={FEATURE_ICONS[i % FEATURE_ICONS.length]} />
                <span set:html={f} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <Sections page={{ ...page, sections }} bandImage={heroBg} />
</Base>
