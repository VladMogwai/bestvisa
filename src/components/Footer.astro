---
import Messengers from './Messengers.astro';
import Icon from './Icon.astro';
import { company, nav } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="footer" id="kontakty">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__contacts">
        <div>
          <small>Звоните, принимаем звонки 24/7</small>
          <a class="footer__phone" href={company.phoneHref} data-goal="click_phone">{company.phone}</a>
          <Messengers />
        </div>
        <div><small>Офис</small>{company.address}<br />м. {company.metro.join(', ')}</div>
        <div><small>Почта</small><a href={`mailto:${company.email}`} data-goal="click_email">{company.email}</a></div>
      </div>
      <div>
        <h4>Услуги</h4>
        <ul class="footer__links">
          {nav.map((n) => <li><a href={n.href}>{n.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Полезное</h4>
        <ul class="footer__links">
          <li><a href="/uslugi/oformlenie-viz/">Все страны</a></li>
          <li><a href="/uslugi/shengenskaya-zona/">Шенгенская зона</a></li>
          <li><a href="/blog/">Блог</a></li>
          <li><a href="/news/">Новости</a></li>
          <li><a href="/o-kompanii-best-visa/">О компании</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {year} BestVisa · {company.legal}. Сайт носит информационный характер и не является публичной офертой.</span>
      <nav aria-label="Документы">
        <a href="/privacy-politic/">Политика конфиденциальности</a>
        <a href="/personal-data/">Согласие на обработку ПДн</a>
      </nav>
    </div>
  </div>
  <div class="footer__mark" aria-hidden="true">
    <svg viewBox="0 0 80 80"><path d="M4 36L76 4 54 74 36 50z" fill="var(--brand)" /><path d="M36 50L76 4 26 42z" fill="var(--cta)" /><path d="M36 50l-4 22 12-14z" fill="var(--brand)" /></svg>
    bestvisa
  </div>
</footer>

<nav class="mbar" aria-label="Быстрая связь">
  <a class="mbar__cta" href="#zayavka" data-goal="click_cta_mobile">Оставить заявку</a>
  <a href={company.phoneHref} data-goal="click_phone" aria-label="Позвонить"><Icon name="phone" /></a>
  <a href="https://t.me/bestvisasbot" data-goal="click_tg" target="_blank" rel="noopener" aria-label="Телеграм"><Icon name="tg" /></a>
  <a href="https://wa.me/79060122950" data-goal="click_wa" target="_blank" rel="noopener" aria-label="Ватсап"><Icon name="wa" /></a>
</nav>
