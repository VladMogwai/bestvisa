---
import Messengers from './Messengers.astro';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { company, nav } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="footer" id="kontakty">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__card footer__card--light">
        <ul class="footer__links">
          {
            nav.map((n) => (
              <li>
                <a href={n.href}>{n.name}</a>
              </li>
            ))
          }
          <li><a href="/blog/">Блог</a></li>
          <li><a href="/news/">Новости</a></li>
        </ul>
        <div class="footer__bottom">
          <span>© {year} Best Visa</span>
          <nav aria-label="Документы">
            <a href="/privacy-politic/">Политика конфиденциальности</a>
            <a href="/personal-data/">Согласие на обработку ПДн</a>
          </nav>
        </div>
      </div>
      <div class="footer__card footer__card--dark">
        <div class="footer__list">
          <div><small>Телефон, звонки 24/7</small><a href={company.phoneHref} data-goal="click_phone" style="font-size:24px">{company.phone}</a></div>
          <div><small>Почта</small><a href={`mailto:${company.email}`} data-goal="click_email">{company.email}</a></div>
          <div><small>Адрес</small>{company.address}<br />м. {company.metro.join(', ')}</div>
          <div><small>Пишите, отвечаем 24/7</small><Messengers icons /></div>
        </div>
        <div class="footer__map">
          <iframe src={company.mapWidget} title="BestVisa на Яндекс Картах" loading="lazy"></iframe>
        </div>
        <div class="footer__photos">
          <img src="/shared/assets/images/entrance-bestvisa.webp" alt="Вход в офис BestVisa" loading="lazy" width="400" height="300" />
          <img src="/shared/assets/images/2026-01-30_00-58-53.webp" alt="Офис BestVisa" loading="lazy" width="400" height="300" />
          <img src="/shared/assets/images/bestvisa-building.webp" alt="Здание, в котором находится BestVisa" loading="lazy" width="400" height="300" />
        </div>
        <p class="footer__bottom" style="border:0;margin-top:20px;padding:0">{company.legal}. Сайт носит информационный характер и не является публичной офертой.</p>
      </div>
    </div>
  </div>
  <div class="footer__mark"><Wordmark /></div>
</footer>

<nav class="mbar" aria-label="Быстрая связь">
  <a href="#zayavka" data-goal="click_cta_mobile">Оставить заявку</a>
  <a href={company.phoneHref} data-goal="click_phone" aria-label="Позвонить"><Icon name="phone" /></a>
  <a href="https://t.me/bestvisasbot" data-goal="click_tg" target="_blank" rel="noopener" aria-label="Телеграм"><Icon name="tg" /></a>
  <a href="https://wa.me/79060122950" data-goal="click_wa" target="_blank" rel="noopener" aria-label="Ватсап"><Icon name="wa" /></a>
</nav>
