---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import SocialProof from '../components/SocialProof.astro';
import FinalCta from '../components/FinalCta.astro';
import Ico from '../components/Ico.astro';
import { company } from '../data/site.js';

import { byPath } from '../data/pages.js';

const home = byPath['/'];
const IMG = '/shared/assets/images';
const price = (path: string) => byPath[path]?.hero?.price?.replace(' руб.', ' ₽') || '';
const term = (path: string) => byPath[path]?.hero?.term?.replace(/^(Срок оформления|Готовность —)\s*/, '') || '';

const SERVICE_ICONS = ['visa', 'passport', 'card', 'shield', 'invite', 'home', 'globe', 'plane'] as const;
const services = [
  { name: 'Оформление виз', text: 'Шенген, США, Великобритания, Азия — всего больше 60 стран. Точно в оговорённый срок', href: '/uslugi/oformlenie-viz/' },
  { name: 'Оформление загранпаспортов', text: 'Готовим все документы и сопровождаем до получения паспорта', href: '/uslugi/poluchit-zagranpasport-v-moskve/' },
  { name: 'Карты иностранных банков', text: 'Открываем удалённо и без лишних поездок', href: '/uslugi/karty-inostrannykh-bankov/' },
  { name: 'Страхование', text: 'Полисы российских страховых компаний для визы и поездки', href: '/uslugi/strakhovanie/' },
  { name: 'Приглашения в РФ', text: 'Приглашения для туристов и деловых гостей', href: '/uslugi/priglasheniya-v-rf/' },
  { name: 'ВНЖ в Европе', text: 'Digital Nomad и другие программы переезда', href: '/uslugi/vnzh-v-evrope/' },
  { name: 'Карта АТЭС', text: 'Быстро соберём документы на карту АТЭС', href: '/uslugi/karta-ates/' },
  { name: 'Туры за рубеж', text: 'Подберём тур под ваши даты и бюджет', href: '/uslugi/tury-za-rubezh/' },
];

const dests = [
  { name: 'Франция', href: '/uslugi/viza-vo-francziyu/', img: '/wp-content/uploads/2025/10/kader-ouattara-auX83Tb21m4-unsplash.webp', wide: true },
  { name: 'Испания', href: '/uslugi/viza-v-ispaniyu/', img: `${IMG}/spain-country.webp` },
  { name: 'Италия', href: '/uslugi/viza-v-italiyu/', img: `${IMG}/italy-country.webp` },
  { name: 'Германия', href: '/uslugi/viza-v-germaniyu/', img: `${IMG}/germany-country.webp` },
  { name: 'Греция', href: '/uslugi/viza-v-greciyu/', img: `${IMG}/greece-country.webp` },
  { name: 'США', href: '/uslugi/viza-v-ssha/', img: `${IMG}/usa-country.webp`, wide: true },
  { name: 'Япония', href: '/uslugi/viza-v-yaponiyu/', img: `${IMG}/japan-country.webp` },
  { name: 'Великобритания', href: '/uslugi/viza-v-britaniyu/', img: `${IMG}/uk-country.webp` },
  { name: 'Канада', href: '/uslugi/viza-v-kanadu/', img: `${IMG}/canada-country.webp` },
  { name: 'Китай', href: '/uslugi/viza-v-kitay/', img: `${IMG}/china-country.webp` },
];

const moreCountries = [
  ['Португалию', '/uslugi/viza-v-portugaliyu/'],
  ['Швейцарию', '/uslugi/viza-v-shveytsariyu/'],
  ['Венгрию', '/uslugi/viza-v-vengriyu/'],
  ['Словению', '/uslugi/viza-v-sloveniyu/'],
  ['Болгарию', '/uslugi/viza-v-bolgariyu/'],
  ['Польшу', '/uslugi/viza-v-polshe/'],
  ['Латвию', '/uslugi/viza-v-latviyu/'],
  ['Литву', '/uslugi/viza-v-litvu/'],
  ['Эстонию', '/uslugi/viza-v-estoniyu/'],
];

const passports = [
  ['Загранпаспорт срочно', '/uslugi/zagran-passport-srochno/'],
  ['Загранпаспорт', '/uslugi/poluchit-zagranpasport-v-moskve/'],
  ['Биометрический на 10 лет', '/uslugi/zagranpasport-10-lev-novogo-obrazca/'],
  ['Старого образца на 5 лет', '/uslugi/zagran-starogo-obrazca-5-let/'],
  ['За 5 дней', '/uslugi/poluchit-zagranpasport-v-moskve/5-dney'],
  ['За 7 дней', '/uslugi/poluchit-zagranpasport-v-moskve/7-dney'],
  ['За 10 дней', '/uslugi/poluchit-zagranpasport-v-moskve/10-dney'],
  ['За 14 дней', '/uslugi/poluchit-zagranpasport-v-moskve/14-dney'],
  ['За неделю', '/uslugi/poluchit-zagranpasport-v-moskve/nedelya'],
  ['За 2 недели', '/uslugi/poluchit-zagranpasport-v-moskve/2-nedeli'],
  ['За 3 недели', '/uslugi/poluchit-zagranpasport-v-moskve/3-nedeli'],
  ['Загранпаспорт за месяц', '/uslugi/poluchit-zagranpasport-v-moskve/za-mesyac/'],
  ['Экспресс загранпаспорт', '/uslugi/ekspress-zagranpasport/'],
];

const why = [
  ['Всё по договору', 'Условия записаны на бумаге, поэтому на каждом этапе вы защищены юридически.'],
  ['98% одобрений', 'Мы знаем требования консульств, поэтому почти все наши заявления получают визу.'],
  ['Работаем с 2013 года', 'За это время — больше 20 000 виз и загранпаспортов. Берёмся и за нестандартные случаи.'],
  ['Цена известна заранее', 'Называем стоимость до начала работы — без скрытых платежей и дополнительных комиссий.'],
  ['Личный менеджер', 'Один специалист ведёт вашу заявку от первого звонка до готового документа.'],
  ['Офис в центре', 'Мы на Тверской: рядом метро Тверская, Пушкинская и Чеховская.'],
];

const posts = [
  { href: '/blog/shengenskaya-viza', date: '31.07.2025', title: 'Шенгенская виза: как оформить, документы, сроки и стоимость', text: 'Разбираем всё, что нужно знать о шенгенской визе: какие документы собирать, сколько стоит, как подать заявление и каковы сроки рассмотрения.' },
  { href: '/blog/viza-vo-franciyu-polnyj-gid', date: '27.02.2026', title: 'Виза во Францию для россиян в 2026 году', text: 'Как оформить визу во Францию в 2026 году: требования, документы, сроки, консульский сбор и лайфхаки для успешной подачи.' },
  { href: '/blog/viza-v-yaponiyu-polnyj-gid', date: '27.02.2026', title: 'Виза в Японию для россиян в 2026 году', text: 'Всё о японской визе: типы виз, необходимые документы, сроки оформления, стоимость услуг и советы от экспертов BestVisa.' },
  { href: '/news/ssha-vvodjat-depozit-15-tysyach-dollarov-pri-podache-na-vizu', date: '20.03.2026', title: 'США вводят депозит $15 000 при подаче на визы для граждан ряда стран', text: 'Администрация Трампа расширила программу визовых залогов до 50 стран. Граждане должны вносить от $5 000 до $15 000 при подаче на визу B1/B2.' },
];
const desc = (path: string) => {
  const t = (byPath[path]?.hero?.lead || '').replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ');
  return t.split(/(?<=\.)\s/)[0];
};
const pad = (n: number) => String(n).padStart(2, '0');
const years = new Date().getFullYear() - company.since;
const counts = [
  { label: 'клиентов с 2013 года', value: company.clients },
  { label: 'заявлений одобряют', value: '98%' },
  { label: 'лет работаем', value: String(years) },
];
const france = byPath['/uslugi/viza-vo-francziyu/']?.sections.find((s: any) => s.kind === 'pricing');
const passportPricing = byPath['/uslugi/poluchit-zagranpasport-v-moskve/']?.sections.find((s: any) => s.kind === 'passportPricing');
const bio = passportPricing?.categories?.[0]?.types?.[0];
---

<Base title={home.title} description={home.description} path="/">
  <section class="hero">
    <div class="hero__split">
      <div class="hero__panel">
        <a class="trust" href={company.rating.url} target="_blank" rel="noopener nofollow">
          <span class="trust__ya">Я</span>
          <span>Надёжный бизнес <b>{company.rating.value}</b> <span class="trust__stars">★★★★★</span> {company.rating.count} отзыва</span>
        </a>
        <h1>Визы и загранпаспорта в Москве — оформим под ключ</h1>
        <p class="hero__lead">BestVisa берёт на себя визы и загранпаспорта: документы, анкеты, запись и подачу. Ещё помогаем с банковскими картами, страховкой и приглашениями.</p>
        <div class="hero__form"><LeadForm page="Главная" /></div>
      </div>
      <div class="hero__photo">
        <img src={`${IMG}/about-bestvisa.webp`} alt="Загранпаспорт в руке перед поездкой" fetchpriority="high" />
        <span class="hero__badge"><b>{company.clients}</b>клиента с 2013 года</span>
      </div>
    </div>
    <div class="strip">
      <ul class="strip__list">
        <li><Ico name="visa" /><span>Визы в 60+ стран мира<br /><a class="link-arrow" href="/uslugi/oformlenie-viz/">Все страны <Ico name="arrow" /></a></span></li>
        <li><Ico name="fast" /><span>Загранпаспорт — от 1 дня<br /><a class="link-arrow" href="/uslugi/zagran-passport-srochno/">Срочно <Ico name="arrow" /></a></span></li>
        <li><Ico name="contract" /><span>Договор и честная цена без доплат<br /><a class="link-arrow" href="/o-kompanii-best-visa/">О компании <Ico name="arrow" /></a></span></li>
        <li><Ico name="chat" /><span>Отвечаем в мессенджерах 24/7<br /><a class="link-arrow" href="https://t.me/bestvisasbot" target="_blank" rel="noopener" data-goal="click_tg">Написать <Ico name="arrow" /></a></span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="statement">
        Оформим <a href="/uslugi/oformlenie-viz/"><Ico name="visa" />визу</a> в 60+ стран,
        <a href="/uslugi/poluchit-zagranpasport-v-moskve/"><Ico name="passport" />загранпаспорт</a> от 1 дня,
        <a href="/uslugi/strakhovanie/"><Ico name="shield" />страховку</a>,
        <a href="/uslugi/priglasheniya-v-rf/"><Ico name="invite" />приглашение</a> и
        <a href="/uslugi/karty-inostrannykh-bankov/"><Ico name="card" />карту иностранного банка</a> — пока вы планируете поездку.
      </p>
    </div>
  </section>

  <section class="dark" id="home-visas">
    <div class="product">
      <div class="product__text">
        <Ico name="visa" class="ico--xl" />
        <h2>Визы</h2>
        <h3>Визы в 60+ стран мира</h3>
        <p>Готовим документы, находим запись и ведём заявку до момента, когда паспорт с визой у вас в руках.</p>
        <ul class="product__perks">
          <li><Ico name="calendar" />Записываем на подачу без долгого ожидания</li>
          <li><Ico name="docs" />Готовим полный пакет документов вместо вас</li>
          <li><Ico name="contract" />Срок получения фиксируем в договоре</li>
          <li><Ico name="plane" />Можно оформить без вашего личного визита</li>
        </ul>
        <div class="product__actions">
          <a class="btn btn--accent" href="/uslugi/oformlenie-viz/">Выбрать страну <Ico name="arrow" /></a>
          <a class="btn btn--ghost" href="/uslugi/shengenskaya-zona/">Шенгенская зона</a>
        </div>
      </div>
      <div class="panel">
        {
          france && (
            <div class="ui">
              <div class="ui__card">
                <div class="ui__title">Виза во Францию · тарифы</div>
                <ul class="ui__rows">
                  {france.tabs.map((t: any) => (
                    <li><span><Ico name="check" />{t.name}</span><b>{t.total}</b></li>
                  ))}
                </ul>
              </div>
              <div class="ui__card ui__card--dark">
                <div class="ui__title">Как идёт оформление</div>
                <div class="ui__steps"><span class="is-done">Документы</span><span class="is-done">Анкета</span><span>Подача</span><span>Виза</span></div>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="dark" id="home-passports">
    <div class="product">
      <div class="product__text">
        <Ico name="passport" class="ico--xl" />
        <h2>Загранпаспорт</h2>
        <h3>Загранпаспорт — от 1 дня</h3>
        <p>Биометрический на 10 лет или старого образца на 5 лет. Вы выбираете срок, мы готовим документы и сопровождаем подачу.</p>
        <ul class="product__perks">
          <li><Ico name="fast" />Срочное оформление</li>
          <li><Ico name="pin" />Официально, через МФЦ Москвы</li>
          <li><Ico name="home" />С любой пропиской — и даже без неё</li>
          <li><Ico name="calendar" />Подаём документы в день обращения</li>
        </ul>
        <div class="product__actions">
          <a class="btn btn--accent" href="/uslugi/poluchit-zagranpasport-v-moskve/">Узнать сроки и цены <Ico name="arrow" /></a>
          <a class="btn btn--ghost" href="/uslugi/zagran-passport-srochno/">Срочно</a>
        </div>
      </div>
      <div class="panel panel--b">
        {
          bio && (
            <div class="ui">
              <div class="ui__card">
                <div class="ui__title">{bio.name} · {passportPricing.categories[0].title.toLowerCase()}</div>
                <ul class="ui__rows">
                  {bio.rows.slice(0, 6).map((r: any) => (
                    <li><span><Ico name="calendar" />{r.period}</span><b>{r.price}</b></li>
                  ))}
                </ul>
                <p class="ui__title" style="margin:8px 0 0">{bio.note}</p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" id="home-services">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Услуги</span>
        <h2>Всё для поездки за границу — в одном месте</h2>
        <p class="lead">Визы, загранпаспорта, страховка, приглашения, карты иностранных банков и туры.</p>
      </div>
      <div class="services">
        {
          services.map((s, i) => (
            <a class="service" href={s.href}>
              <Ico name={SERVICE_ICONS[i]} />
              <h3>{s.name}</h3>
              <p>{s.text}</p>
              <span class="link-arrow">Подробнее <Ico name="arrow" /></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section tint" id="home-dests">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Направления</span>
        <h2>Популярные страны</h2>
        <p class="lead">Цена услуги и срок оформления — сразу на карточке.</p>
      </div>
      <div class="dests">
        {
          dests.map((d) => (
            <a class="dest" href={d.href}>
              <div class="dest__img"><img src={d.img} alt={`Виза в ${d.name}`} loading="lazy" width="400" height="300" /></div>
              <div class="dest__body">
                <h3>{d.name}</h3>
                <span class="dest__meta">
                  {price(d.href) && <strong>{price(d.href)}</strong>} {term(d.href) && `· ${term(d.href)}`}
                </span>
              </div>
            </a>
          ))
        }
      </div>
      <div class="chips" style="margin-top:24px">
        {moreCountries.map(([n, h]) => <a class="chip" href={h}>В {n}</a>)}
        <a class="chip chip--accent" href="/uslugi/oformlenie-viz/">Все страны →</a>
      </div>
    </div>
  </section>

  <section class="section" id="home-counter">
    <div class="wrap counter">
      <span class="eyebrow">С 2013 года</span>
      <div class="counter__num"><span data-odometer>{company.clients}</span></div>
      <p>клиентов получили визы, загранпаспорта и другие документы с BestVisa</p>
    </div>
  </section>

  <div class="ratings">
    <span><span class="trust__ya">Я</span> <b>{company.rating.value}</b> <span class="trust__stars">★★★★★</span> {company.rating.count} отзыва на Яндекс Картах</span>
    <span><Ico name="contract" /> Работаем по договору</span>
    <span><Ico name="check" /> 98% одобрений</span>
    <span><Ico name="pin" /> Офис на Тверской</span>
  </div>

  <section class="section" id="home-discount">
    <div class="wrap">
      <div class="discount">
        <span class="discount__big">−25%</span>
        <div>
          <h2>Закажите загранпаспорт — и <a href="/uslugi/oformlenie-viz/">визу</a> оформим на 25% дешевле</h2>
          <p>Скидка действует на любую визу при оформлении загранпаспорта у нас. Детали расскажет специалист.</p>
        </div>
        <a class="btn btn--accent" href="#zayavka" data-order="Скидка 25% на визу при оформлении загранпаспорта">Оформить со скидкой <Ico name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section" id="home-why">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Почему мы</span>
        <h2>Почему клиенты остаются с нами</h2>
        <p class="lead">Шесть причин, по которым BestVisa выбирают вместо других визовых центров.</p>
      </div>
      <div class="cols">
        {
          why.map(([t, p], i) => (
            <div>
              <Ico name={(['contract', 'check', 'star', 'ruble', 'person', 'pin'] as const)[i]} class="ico--lg" />
              <h3>{t}</h3>
              <p>{p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <SocialProof />

  <section class="section tint" id="home-about">
    <div class="wrap about">
      <div class="about__media">
        <img src={`${IMG}/2026-01-30_00-58-53.webp`} alt="Офис BestVisa" loading="lazy" width="960" height="720" />
      </div>
      <div>
        <span class="eyebrow">О компании</span>
        <h2>BestVisa — визы и паспорта на Тверской</h2>
        <p>Наш офис — в центре Москвы, между Тверской и Пушкинской. С 2013 года мы полностью ведём оформление виз, загранпаспортов и сопутствующих документов.</p>
        <p>Делаем загранпаспорта обоих видов — старого образца на 5 лет и биометрические на 10 лет. Оформляем визы под любую цель поездки: туризм, бизнес, учёбу, лечение, частный визит. Готовим приглашения для иностранцев, которые едут в Россию.</p>
        <p>Помогаем открыть карту иностранного банка и получить карту АТЭС. Работаем и с частными, и с корпоративными клиентами. На нашем счету больше {company.clients} виз и загранпаспортов, и опыт команды выручает даже в нестандартных ситуациях.</p>
        <a class="btn btn--light" href="/o-kompanii-best-visa/">Подробнее о компании <Ico name="arrow" /></a>
      </div>
    </div>
  </section>

  <FinalCta page="Главная" />

  <section class="section" id="home-blog">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Блог</span>
        <h2>Читать перед поездкой</h2>
        <p class="lead"><a class="link-arrow" href="/blog/">Все статьи <Ico name="arrow" /></a> &nbsp; <a class="link-arrow" href="/news/">Все новости <Ico name="arrow" /></a></p>
      </div>
      <div class="posts">
        {
          posts.map((p) => (
            <a class="post" href={p.href}>
              <time>{p.date}</time>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
