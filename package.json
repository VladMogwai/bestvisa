{
  "name": "bestvisa",
  "type": "module",
  "private": true,
  "scripts": {
    "extract": "node migration/extract.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "images": "node migration/images.mjs",
    "build:preview": "PUBLIC_ENV=preview npm run build && rm -f dist/.htaccess && printf '/*\\n  X-Robots-Tag: noindex, nofollow\\n' > dist/_headers",
    "deploy:preview": "npm run build:preview && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "wrangler": "^4.151.2"
  }
}
