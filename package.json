{
  "name": "bestvisa",
  "type": "module",
  "private": true,
  "scripts": {
    "extract": "node migration/extract.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "images": "node migration/images.mjs",
    "build:preview": "PUBLIC_ENV=preview npm run build && rm -f dist/.htaccess && printf '/*\\n  X-Robots-Tag: noindex, nofollow\\n' > dist/_headers",
    "deploy:preview": "npm run build:preview && wrangler deploy",
    "check:facts": "node scripts/check-facts.mjs",
    "images:pexels": "node migration/pexels.mjs && node migration/images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "cheerio": "^1.2.0",
    "wrangler": "^4.151.2"
  }
}
